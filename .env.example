# Mode is explicit. Demo is deterministic; live mode fails closed on any DataHub read error.
IGRAPH_CONTEXT_MODE=demo
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=
# DATAHUB_TOKEN is also supported for compatibility.
DATAHUB_TOKEN=

# Required in live deployments. Never commit a real value.
IGRAPH_SIGNING_SECRET=replace-with-a-long-random-secret

# Writeback is opt-in. When true, iGraph preserves existing custom properties
# and adds igraph.* review metadata to the analyzed DataHub entity.
IGRAPH_ENABLE_WRITEBACK=false
